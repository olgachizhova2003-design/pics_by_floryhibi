","type":"ma_vat","placeholder":"12345678","country":"MA","description":"Moroccan VAT Number","reverse_charge":true,"region":"MA","verifiable":false},"ge_vat":{"country":"GE","supported":true,"placeholder":"123456789","format":"([0-9]{9}|[0-9]{11})","country_label":"Georgia","reverse_charge":true,"stripe_type":"ge_vat","type":"ge_vat","region":"GE","verifiable":false,"description":"Georgian VAT"},"tr_tin":{"placeholder":"0123456789","type":"tr_tin","format":"[0-9]{10,11}","country":"TR","description":"Turkish Tax Identification Number","country_label":"Türkiye","region":"TR","verifiable":false,"supported":true,"stripe_type":"tr_tin","reverse_charge":true},"mx_rfc":{"replacement_string":"\\1\\2\\3\\4\\5\\6","country":"MX","type":"mx_rfc","verifiable":false,"description":"Mexican RFC number","format":"([A-Za-zÑñ\u0026]{3,4})-?([0-9]{2})(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])-?([A-Za-z0-9])-?([A-Za-z0-9][0-9A])","reverse_charge":true,"supported":true,"stripe_type":"mx_rfc","placeholder":"ABC010203AB9","region":"MX","country_label":"Mexico"},"lv_vat":{"supported":true,"description":"European VAT number","reverse_charge":true,"type":"lv_vat","country_label":"Latvia","placeholder":"LV12345678912","stripe_type":"eu_vat","country":"LV","region":"EEA-GB-CH","verifiable":true,"format":"LV[0-9]{11}"},"za_vat":{"description":"South African VAT number","supported":true,"reverse_charge":false,"placeholder":"4123456789","stripe_type":"za_vat","region":"ZA","country":"ZA","type":"za_vat","format":"4[0-9]{9}","verifiable":false,"country_label":"South Africa"},"si_vat":{"type":"si_vat","placeholder":"SI12345678","country":"SI","verifiable":true,"format":"SI[0-9]{8}","country_label":"Slovenia","reverse_charge":true,"supported":true,"stripe_type":"eu_vat","region":"EEA-GB-CH","description":"European VAT number"},"ca_pst_sk":{"region":"CA","format":"([0-9]{7})","country_label":"Canada","country":"CA","reverse_charge":false,"type":"ca_pst_sk","supported":true,"placeholder":"1234567","ver