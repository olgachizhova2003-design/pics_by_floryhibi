ry":"IE","description":"European VAT number"},"au_arn":{"stripe_type":"au_arn","country":"AU","region":"AU","type":"au_arn","country_label":"Australia","verifiable":false,"supported":false,"placeholder":"123456789123","format":"[0-9]{12}","description":"Australian Taxation Office Reference Number","reverse_charge":true},"th_vat":{"region":"TH","country_label":"Thailand","type":"th_vat","placeholder":"1234567891234","description":"Thai VAT","stripe_type":"th_vat","reverse_charge":true,"country":"TH","supported":true,"verifiable":false,"format":"[0-9]{13}"},"my_itn":{"stripe_type":"my_itn","description":"Malaysian ITN","supported":false,"country":"MY","type":"my_itn","country_label":"Malaysia","format":"([A-Z]{1,2}) ?([0-9]{10})","region":"MY","verifiable":false,"replacement_string":"\\1 \\2","reverse_charge":true,"placeholder":"C 1234567890"},"fi_vat":{"type":"fi_vat","country":"FI","description":"European VAT number","reverse_charge":true,"format":"FI[0-9]{8}","country_label":"Finland","stripe_type":"eu_vat","verifiable":true,"region":"EEA-GB-CH","placeholder":"FI12345678","supported":true},"nl_vat":{"type":"nl_vat","stripe_type":"eu_vat","format":"NL[0-9]{9}B[0-9]{2}","country":"NL","country_label":"Netherlands","description":"European VAT number","placeholder":"NL123456789B12","verifiable":true,"reverse_charge":true,"region":"EEA-GB-CH","supported":true},"br_cpf":{"replacement_string":"\\1.\\2.\\3-\\4","description":"Brazilian CPF number","supported":false,"type":"br_cpf","country_label":"Brazil","region":"BR","reverse_charge":false,"placeholder":"123.456.789-87","country":"BR","stripe_type":"br_cpf","format":"([0-9]{3})\\.?([0-9]{3})\\.?([0-9]{3})\\-?([0-9]{2})","verifiable":false},"dk_vat":{"description":"European VAT number","placeholder":"DK12345678","stripe_type":"eu_vat","reverse_charge":true,"country":"DK","supported":true,"format":"DK[0-9]{8}","verifiable":true,"type":"dk_vat","country_label":"Denmark","region":"EEA-GB-CH"},"ca_bn":{"placeholder":"123456789","type":"ca_bn","supported":true,"verifiable":false,"stripe_type":"ca_bn","country":"CA","region":"CA","reverse_charge":false,"description":"Canadian BN","format":"[0-9]{9}","country_label":"Canada"},"tw_vat":{"stripe_type":"tw_vat","format":"[0-9]{8}","description":"Taiwanese VAT","country":"TW","verifiable":false,"region":"TW","reverse_charge":true,"country_label":"Taiwan","placeholder":"12345678","type":"tw_vat","supported":true},"cy_vat":{"supported":true,"region":"EEA-GB-CH","type":"cy_vat","format":"CY[0-9]{8}[A-Z]","verifiable":true,"stripe_type":"eu_vat","placeholder":"CY12345678Z","reverse_charge":true,"country_label":"Cyprus","description":"European VAT number","country":"CY"},"kr_brn":{"country_label":"South Korea","format":"([0-9]{3})-?([0-9]{2})-?([0-9]{5})","country":"KR","stripe_type":"kr_brn","description":"Korean BRN","region":"KR","type":"kr_brn","replacement_string":"\\1-\\2-\\3","supported":true,"reverse_charge":true,"placeholder":"123-45-67890","verifiable":false},"my_sst":{"reverse_charge":true,"region":"MY","replacement_string":"\\2-\\3-\\4","country":"MY","placeholder":"A12-3456-78912345","only_replace_if_group_captured":2,"stripe_type":"my_sst","type":"my_sst","format":"(([A-Z][0-9]{2})-?([0-9]{4})-?([0-9]{8})|[0-9]{8})","country_label":"Malaysia","description":"Malaysian SST number","supported":false,"verifiable":false},"nz_gst":{"supported":true,"verifiable":false,"reverse_charge":true,"country":"NZ","country_label":"New Zealand","stripe_type":"nz_gst","description":"New Zealand GST number","region":"NZ","format":"[0-9]{8,9}","placeholder":"123456789","type":"nz_gst"},"my_frp":{"stripe_type":"my_frp","reverse_charge":true,"verifiable":false,"type":"my_frp","region":"MY","placeholder":"12345678","description":"Malaysian FRP number","country":"MY","format":"[0-9]{8}","country_label":"Malaysia","supported":false},"se_vat":{"reverse_charge":true,"country":"SE","format":"SE[0-9]{12}","placeholder":"SE123456789123","type":"se_vat","region":"EE